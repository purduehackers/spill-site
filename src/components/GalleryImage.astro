---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  placeholder: string;
  alt: string;
  class?: string;
  index: number;
  loading?: "lazy" | "eager";
  sizes?: string;
}

const { src, placeholder, alt, class: className, index, loading = "lazy", sizes = "(max-width: 768px) 100vw, 33vw" } = Astro.props;
---

<div class={`gallery-image-wrapper relative w-full block overflow-hidden ${className}`}>
  <div
    class="absolute inset-0 bg-cover bg-center blur-lg scale-110"
    style={`background-image: url('${placeholder}');`}
  ></div>
  <button
    type="button"
    class="gallery-trigger relative z-10 w-full h-auto cursor-pointer block p-0 border-0 bg-transparent"
    data-index={index}
    aria-label={`View full screen ${alt}`}
  >
    <Image
      src={src}
      alt={alt}
      widths={[240, 540, 720, 1024, 1600]}
      sizes={sizes}
      class="w-full h-auto transition-opacity duration-700 opacity-0"
      onload="this.classList.remove('opacity-0')"
      loading={loading}
    />
  </button>
</div>
