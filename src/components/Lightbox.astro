<div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/95 flex items-center justify-center p-4 transition-opacity duration-300 opacity-0 pointer-events-none" aria-hidden="true">
  <button id="lightbox-close" class="absolute top-4 right-4 z-50 text-white/80 hover:text-white p-2 transition-colors" aria-label="Close lightbox">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <button id="lightbox-prev" class="absolute left-2 md:left-8 z-50 text-white/80 hover:text-white p-2 transition-colors hidden" aria-label="Previous image">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 drop-shadow-lg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button id="lightbox-next" class="absolute right-2 md:right-8 z-50 text-white/80 hover:text-white p-2 transition-colors hidden" aria-label="Next image">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 drop-shadow-lg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div class="relative w-full h-full flex items-center justify-center">
    <div id="lightbox-image-wrapper" class="relative max-w-full max-h-full">
        <div id="lightbox-placeholder" class="absolute inset-0 bg-cover bg-center blur-md transition-opacity duration-500 opacity-0"></div>
        <img id="lightbox-img" src="" alt="Fullscreen view" class="relative z-10 max-w-full max-h-[90vh] object-contain transition-opacity duration-300 opacity-0" />
    </div>
  </div>
</div>