---
export const prerender = false;

const { id } = Astro.params;
const userAgent = Astro.request.headers.get('user-agent') || '';

const isBot = /bot|crawler|spider|crawling|facebookexternalhit|twitterbot/i.test(userAgent);

const imageUrl = `${import.meta.env.PUBLIC_ENDPOINT}/tickets/${id}.png`;

if (!isBot) {
    return Astro.redirect('/tickets');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>join me at spill 2025 ≋</title>
    <meta name="description" content="a one way ticket to a three hour creative-technical student demo. only here for three hours and then never again" />
    
    <meta property="og:title" content="join me at spill 2025 ≋" />
    <meta property="og:description" content="a one way ticket to a three hour creative-technical student demo. only here for three hours and then never again" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="join me at spill 2025 ≋" />
    <meta name="twitter:description" content="a one way ticket to a three hour creative-technical student demo. only here for three hours and then never again" />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <h1>join me at spill 2025 ≋</h1>
    <img src={imageUrl} alt="Spill 2025 Ticket" />
  </body>
</html>
