---
import Layout from '@/layouts/Layout.astro';
import Logo from "public/logo.svg";
import { getImage } from 'astro:assets';
import Gallery from '@/components/Gallery';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/img/event/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const placeholderFiles = import.meta.glob<{ default: string }>('../assets/img/event/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true, query: { lqip: true } });

const brochureFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/img/brochure/*.png', { eager: true });
const brochurePlaceholders = import.meta.glob<{ default: string }>('../assets/img/brochure/*.png', { eager: true, query: { lqip: true } });

const widths = [240, 540, 720, 1024, 1600];

async function processImage(meta: ImageMetadata, placeholder: string, alt: string, className?: string) {
  const optimized = await getImage({ src: meta, widths, formats: ['webp'] });
  return {
    src: optimized.src,
    srcSet: optimized.srcSet?.attribute,
    width: meta.width,
    height: meta.height,
    placeholder,
    alt,
    className,
  };
}

const brochureImages = await Promise.all([
  { path: '../assets/img/brochure/0.png', className: '' },
  { path: '../assets/img/brochure/1.png', className: 'md:mt-12' },
  { path: '../assets/img/brochure/2.png', className: 'md:mt-24' },
].map(page => processImage(
  brochureFiles[page.path].default,
  brochurePlaceholders[page.path].default,
  "Event brochure page",
  page.className
)));

const sortedEventPaths = Object.keys(imageFiles).sort((pathA, pathB) => {
  const fileA = pathA.split('/').pop() || '';
  const fileB = pathB.split('/').pop() || '';
  return fileA.localeCompare(fileB, undefined, { numeric: true });
});

const eventImages = await Promise.all(
  sortedEventPaths.map(path => processImage(
    imageFiles[path].default,
    placeholderFiles[path]?.default || '',
    "Event image"
  ))
);
---

<Layout
  title="spill"
  description="an exhibition of student-made creative technical projects."
>
  <main class="w-full min-h-[90vh] flex flex-col md:flex-row justify-between items-center px-4 sm:px-6 md:ps-20">
    <div class="w-full mt-8 flex flex-col md:flex-row justify-between items-end gap-12">
      <!-- Left side (big heading) -->
      <section class="z-1 w-full md:w-1/2 md:h-[500px] flex items-center justify-center">
        <div class="md:fixed md:top-0 md:left-0 md:w-1/2 h-full flex items-center justify-center">
          <Logo style="filter:url(#goof) brightness(45%); opacity: 90%" class="hi goo"/>
        </div>

      </section>

      <!-- Right side (text) -->
      <div class="flex w-full md:w-1/2 flex-col gap-y-4">
        <div class="flex flex-col gap-y-4">
          <p class="font-body text-base mt-0 sm:mt-4 sm:text-xl">
            was a <span class="realistic-marker-highlight">showcase</span> of
            student-made creative technical projects, run by <a
              href="https://www.purduehackers.com"
              target="_blank"
              rel="noopener noreferrer"
              class="purdue-hackers-link"
            >
              <span class="sketch-highlight hover:text-decoration-underline"
                >purdue hackers</span
              ></a
            >.
          </p>
          <p class="font-body leading-relaxed text-xl sm:text-xl">
            <span class="realistic-marker-highlight">december 6, 2025 • 7-10pm</span>
            <br />
            <a href="https://www.google.com/maps/place/Vienna+Espresso+Bar+%26+Bakery/@40.4240332,-86.9101418,16z/data=!3m1!4b1!4m15!1m8!3m7!1s0x8812e2aecf78386f:0x83449d81b828d42b!2sVienna+Espresso+Bar+%26+Bakery!8m2!3d40.4240332!4d-86.9075669!10e1!16s%2Fg%2F1thl1g87!3m5!1s0x8812e2aecf78386f:0x83449d81b828d42b!8m2!3d40.4240332!4d-86.9075669!16s%2Fg%2F1thl1g87?entry=ttu&g_ep=EgoyMDI1MTAyMi4wIKXMDSoASAFQAw%3D%3D"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="purdue-hackers-link flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 640 640"
                    class="w-5 h-5 -translate-y-0.25 inline-block align-middle fill-current">
                  <path d="M352 348.4C416.1 333.9 464 276.5 464 208C464 128.5 399.5 64 320 64C240.5 64 176 128.5 176 208C176 276.5 223.9 333.9 288 348.4L288 544C288 561.7 302.3 576 320 576C337.7 576 352 561.7 352 544L352 348.4zM328 160C297.1 160 272 185.1 272 216C272 229.3 261.3 240 248 240C234.7 240 224 229.3 224 216C224 158.6 270.6 112 328 112C341.3 112 352 122.7 352 136C352 149.3 341.3 160 328 160z"/>
                </svg>
                vienna coffee house
            </a>
          </p>
          <p class="font-body leading-relaxed sm:text-lg">
            projects aren't sterile or perfect—they're made by <span
              class="realistic-marker-highlight"
            >
              people, late nights,
            </span>
            <span class="sketch-highlight">spilled coffee</span>, and lots of <span
              class="realistic-marker-highlight">trial & error</span
            >.
          </p>
          <br />
          <p class="font-body leading-relaxed sm:text-lg">
            200 people entered a warm coffee shop on a cold night, grabbed a free drink, and experienced interactive
            installations, digital experiments, and visual stories created by purdue students.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Gallery brochureImages={brochureImages} eventImages={eventImages} client:load />
</Layout>
