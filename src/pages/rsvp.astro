---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="spill | tickets"
  description="an upcoming exhibition of student-made creative technical projects."
>
    <div class="h-screen min-h-screen flex flex-col md:flex-col px-4 sm:px-6 md:p-6">
        <!--
        <h1 class="font-heading goo text-[25vh] leading-none font-bold sm:text-[30vh] md:text-[50vh]" style="filter: url(#goof);">
            ~~~~
        </h1>
         -->
        
        <div class="w-full h-1/6">
            hihi
        </div>

        <div class="w-full h-3/4 flex gap-4">
            <div class="w-1/2 h-full flex flex-col gap-4 bg-coffee text-paper border-2 border-coffee rounded-lg p-4">
                <div>
                     ಃ create your ticket ಀ
                </div>
                <div>
                    <input class=""
                        type="text"
                        placeholder="name"
                    />
                </div>
            </div>

            <div class="w-1/2 h-full flex flex-col gap-4 justify-between border-2 border-coffee rounded-lg p-4">
                <div>
                    hello friends
                </div>

                <div class="flex flex-col gap-2 p-6">
                    <div class="flex flex-row gap-2">
                        <div class="tea-tag w-24 h-24">
                            <div class="w-full h-full flex flex-col items-center justify-center">
                                <span>tea</span>
                                <span>tag!</span>
                            </div>
                        </div>
                        <div class="tea-tag w-24 h-24 bg-sage">
                            <div class="w-full h-full flex flex-col items-center justify-center">
                                <span>tea</span>
                                <span>tag!</span>
                            </div>
                        </div>
                        <div class="tea-tag w-24 h-24 bg-coffee-light">
                            <div class="w-full h-full flex flex-col items-center justify-center">
                                <span>tea</span>
                                <span>tag!</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex flex-col gap-2 p-6">
                    <div class="flex flex-row gap-2">
                        <div class="tea-tag-oct w-24 h-24 bg-pine">
                            <div class="w-full h-full flex flex-col items-center justify-center">
                                <span>tea</span>
                                <span>tag!</span>
                            </div>
                        </div>
                        <div class="tea-tag-oct w-24 h-24 bg-red-clay">
                            <div class="w-full h-full flex flex-col items-center justify-center">
                                <span>tea</span>
                                <span>tag!</span>
                            </div>
                        </div>
                        <div class="tea-tag-oct w-24 h-24 bg-coffee">
                            <div class="w-full h-full flex flex-col items-center justify-center">
                                <span>tea</span>
                                <span>tag!</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </main>
</BaseLayout>